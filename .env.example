# --- CicloRadar · variables de entorno ---
# Copia a .env (o expórtalas) y rellena. Solo datos macro públicos, sin PII.

# FRED / ALFRED — clave gratuita en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Telegram (alertas). Token del bot y chat_id de destino.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Parámetros del modelo (punto de arranque del spec; OQ-02/03/05) ---
MOMENTUM_WINDOW=3        # ventana de momentum PRIMARIA (gobierna la alerta)
MOMENTUM_WINDOW_ALT=6    # ventana de momentum SECUNDARIA (comparación)
AMBER_LEVEL=80          # umbral ámbar (percentil p80)
RED_LEVEL=90           # umbral rojo  (percentil p90)
AMBER_ACCEL=10         # aceleración (Δ índice) que dispara ámbar
RED_ACCEL=15           # aceleración que dispara rojo
RED_PERSISTENCE=2      # lecturas consecutivas para confirmar ROJO
MIN_BLOCKS=2           # cobertura mínima de bloques para emitir índice

# --- Operación ---
CICLORADAR_DB=cicloradar_history.sqlite
HTTP_TIMEOUT=30
HTTP_RETRIES=4
